<odoo>
  <data>
    <record id="res_config_settings_view_form" model="ir.ui.view">
      <field name="name">res.config.settings.view.form.inherit.easy.distro</field>
      <field name="model">res.config.settings</field>
      <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//form" position="inside">
          <app data-string="Easy Distro" string="Easy Distro" name="easy_distro" logo="/easy_distro/static/description/icon.png">
            <block title="Subscription Settings" name="subscription_settings">
              <setting id="easy_distro_subscription_id" string="Subscription Configuration" help="Enter your subscription ID from your external billing account." documentation="https://vikuno.com/modules/easy-distro" title="In order to use this feature, you need to activate your subscription.">
                <field name="easy_distro_subscription_id"/>
                <button name="easy_distro_check_subscription_status" type="object" string="Activate Subscription" class="btn-secondary ps-2 w-100" icon="fa-refresh" title="Get the status of your subscription from your external billing account."/>
              </setting>
            </block>
          </app>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
